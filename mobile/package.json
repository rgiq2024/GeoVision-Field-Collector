{
  "name": "geovision-collector-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android and iPhone app for GeoVision Field Collector",
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "sync": "node scripts/build-www.mjs && cap sync",
    "android": "node scripts/build-www.mjs && cap sync android && cap open android",
    "ios": "node scripts/build-www.mjs && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "lz-string": "1.5.0"
  }
}
